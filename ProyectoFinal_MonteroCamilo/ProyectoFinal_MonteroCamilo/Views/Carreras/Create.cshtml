@model ProyectoFinal_MonteroCamilo.Models.Carrera
@{
    ViewData["Title"] = "Nueva carrera";
}
<h1>Nueva carrera</h1>
<form asp-action="Create" method="post" class="col-md-6">
    <partial name="_CarreraForm" model="Model" />
    <button class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}