@model ProyectoFinal_MonteroCamilo.ViewModels.PlanCarreraViewModel
@{
    ViewData["Title"] = "Plan de estudios";
}
<h1>Plan de estudios: @Model.Carrera.Nombre</h1>
<partial name="_Mensajes" />

<form asp-action="AgregarCurso" method="post" class="row g-2 mb-4">
    <input type="hidden" name="carreraId" value="@Model.Carrera.Id" />
    <div class="col-md-6">
        <select name="cursoId" class="form-select" asp-items="Model.CursosDisponibles" required>
            <option value="">-- Seleccione un curso --</option>
        </select>
    </div>
    <div class="col-md-3"><input type="number" name="cuatrimestre" class="form-control" min="1" max="12" placeholder="Cuatrimestre" required /></div>
    <div class="col-md-3"><button class="btn btn-primary">Agregar al plan</button></div>
</form>

@foreach (var g in Model.Items.GroupBy(i => i.Cuatrimestre))
{
    <h5 class="mt-3">Cuatrimestre @g.Key</h5>
    <table class="table table-sm align-middle">
        @foreach (var i in g)
        {
            <tr>
                <td>@i.Curso?.Codigo</td>
                <td>@i.Curso?.Nombre</td>
                <td>@i.Curso?.Creditos créditos</td>
                <td class="text-end">
                    <form asp-action="QuitarCurso" method="post" class="d-inline">
                        <input type="hidden" name="carreraId" value="@i.CarreraId" />
                        <input type="hidden" name="cursoId" value="@i.CursoId" />
                        <button class="btn btn-sm btn-outline-danger">Quitar</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
@if (!Model.Items.Any())
{
    <p class="text-muted">Esta carrera aún no tiene cursos en su plan.</p>
}
<a asp-action="Index">Volver a carreras</a>