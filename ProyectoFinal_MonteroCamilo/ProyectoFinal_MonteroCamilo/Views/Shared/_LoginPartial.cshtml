@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Panel" asp-action="Index">Hola, @User.Identity?.Name</a></li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark border-0">Cerrar sesión</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Registrarse</a></li>
        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
    }
</ul>