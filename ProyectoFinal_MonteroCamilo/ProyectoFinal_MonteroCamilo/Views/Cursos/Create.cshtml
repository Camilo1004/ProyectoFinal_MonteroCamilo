@model ProyectoFinal_MonteroCamilo.ViewModels.CursoFormViewModel
@{
    ViewData["Title"] = "Nuevo curso";
}
<h1>Nuevo curso</h1>
<form asp-action="Create" method="post" class="col-md-6">
    <partial name="_CursoForm" model="Model" />
    <button class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}